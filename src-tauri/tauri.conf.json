{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperAround",
  "version": "0.1.3",
  "identifier": "com.whisperaround.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperAround",
        "label": "main",
        "width": 72,
        "height": 40,
        "resizable": false,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "title": "WhisperAround — Ajustes",
        "label": "settings",
        "width": 420,
        "height": 520,
        "minWidth": 360,
        "minHeight": 440,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
