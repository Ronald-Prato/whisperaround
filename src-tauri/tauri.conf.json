{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperAround",
  "version": "0.1.6",
  "identifier": "com.whisperaround.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "WhisperAround",
        "label": "main",
        "width": 44,
        "height": 24,
        "resizable": false,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "title": "WhisperAround",
        "label": "settings",
        "width": 820,
        "height": 580,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 24 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar", "mica"], "state": "followsWindowActiveState" }
      },
      {
        "title": "Welcome to WhisperAround",
        "label": "welcome",
        "width": 460,
        "height": 440,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "lproj/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "lproj/es.lproj/InfoPlist.strings",
        "Resources/pt_BR.lproj/InfoPlist.strings": "lproj/pt_BR.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "lproj/fr.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "lproj/de.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "lproj/it.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "lproj/ko.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "lproj/ja.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "lproj/zh-Hans.lproj/InfoPlist.strings"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMUY1NTU3QjdDNjVGMzEKUldReFg4YTNWMVVmbmlyWXNaNEpVblNMSmN5MkJRNjZzYzBFMkFadTUvMFRKYldkVE1vMjNhV3kK",
      "endpoints": [
        "https://github.com/dansaround/whisperaround/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
