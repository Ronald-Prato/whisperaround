{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperAround",
  "version": "0.1.6",
  "identifier": "com.whisperaround.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperAround",
        "label": "main",
        "width": 72,
        "height": 40,
        "resizable": false,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "title": "WhisperAround — Ajustes",
        "label": "settings",
        "width": 420,
        "height": 520,
        "minWidth": 360,
        "minHeight": 440,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "center": true
      },
      {
        "title": "Bienvenido a WhisperAround",
        "label": "welcome",
        "width": 460,
        "height": 440,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMUY1NTU3QjdDNjVGMzEKUldReFg4YTNWMVVmbmlyWXNaNEpVblNMSmN5MkJRNjZzYzBFMkFadTUvMFRKYldkVE1vMjNhV3kK",
      "endpoints": [
        "https://github.com/dansaround/whisperaround/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
